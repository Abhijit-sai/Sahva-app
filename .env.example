NODE_ENV=development
PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
# Web defaults to its origin. APK uses a fixed HTTPS origin or prompts for the test deployment.
VITE_API_BASE_URL=
VITE_PUBLIC_WEB_URL=
# Match the HTTPS domain used in the Android verified link.
SAHVA_WEB_HOST=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql://sahva:replace-me@rds-endpoint:5432/sahva?sslmode=require
# In production mount the AWS RDS CA bundle. Prefer verify-full with the installed CA.
# NODE_EXTRA_CA_CERTS=/run/certs/global-bundle.pem
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Leave both empty for the EC2 instance role or ECS task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INTERNAL_CALL_API_KEY=
# Optional default registered caller for internal rings. Otherwise a service identity is used.
INTERNAL_CALLER_USER_ID=

